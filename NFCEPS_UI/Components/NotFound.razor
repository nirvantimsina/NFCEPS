@page "/404"
@page "/{*path:nonfile}"
@layout Layout.EmptyLayout

<div class="d-flex flex-column align-center justify-center vh-100">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Error" Style="font-size: 5rem;" />
    <MudText Typo="Typo.h3" Class="mt-4">Page Not Found</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">The URL "@path" doesn't exist.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/dashboard">
        Back to Dashboard
    </MudButton>
</div>

@code {
    [Parameter] public string? path { get; set; }
}
