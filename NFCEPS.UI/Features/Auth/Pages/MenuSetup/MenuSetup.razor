@using NFCEPS.UI.Shared.Security
@page "/menusetup"
@inherits PermissionAwareBase
@using NFCEPS.UI.Shared.Infrastructure
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle> MenuSetup - NFCEPS</PageTitle>

<div class="dash-topbar">
    <div>
        <h1 class="dash-title">Menu Setup</h1>
    </div>
</div>

<MudContainer>
    <MudPaper Elevation="4" Class="mt-2">
        <MudDataGrid T="MenuListModel" Items="@response">
            <Columns>
                <PropertyColumn Property="x => x.MenuId" Title="Menu ID" />
                <PropertyColumn Property="x => x.MenuName" Title="Menu Name" />
                <PropertyColumn Property="x => x.ParentId" Title="Parent Id" />
                <PropertyColumn Property="x => x.Icon" Title="Icon" />
                <PropertyColumn Property="x => x.Path" Title="Path URI" />
                <PropertyColumn Property="x => x.MenuOrder" Title="Menu Order" />
                <PropertyColumn Property="x => x.ChildId" Title="Child ID (Obselete)" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
</MudContainer>

